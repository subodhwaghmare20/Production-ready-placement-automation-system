# ==========================================
# Placement Candidate Management & WhatsApp Automation System
# Root Environment Configuration Template (.env.example)
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/placement_automation
CLIENT_URL=http://localhost:5173

# Authentication & Session Security
JWT_SECRET=replace_with_strong_random_jwt_secret_minimum_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_strong_random_cookie_secret_minimum_32_chars

# Initial Bootstrap Administrator (Auto-seeded on first run)
ADMIN_NAME=Placement Officer
ADMIN_EMAIL=admin@placement.edu
ADMIN_PASSWORD=Admin@12345

# Module 10: Official WhatsApp Business Cloud API & Webhooks
ENCRYPTION_KEY=replace_with_aes_256_bit_key_exactly_32_bytes_long!
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=replace_with_custom_webhook_verification_token
META_GRAPH_VERSION=v21.0
WEBHOOK_BASE_URL=http://localhost:5000

# Client Frontend
VITE_API_URL=/api
